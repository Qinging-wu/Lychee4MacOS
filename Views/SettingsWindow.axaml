<Window x:Class="Lychee.Views.SettingsWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lychee Settings"
        Width="360"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="12">
        <TextBlock Text="Settings" FontSize="18" FontWeight="Bold" Foreground="#FFB5DE56"/>

        <Border Background="#22FFFFFF" CornerRadius="8" Padding="12">
            <StackPanel Spacing="10">
                <TextBlock Text="Modules" FontWeight="SemiBold" Foreground="#FFCCCCCC"/>
                <ItemsControl x:Name="ModuleToggleList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding DisplayName}"
                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                      Checked="ModuleToggle_Changed"
                                      Unchecked="ModuleToggle_Changed"
                                      Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Background="#22FFFFFF" CornerRadius="8" Padding="12">
            <StackPanel Spacing="8">
                <TextBlock Text="Floating ball" FontWeight="SemiBold" Foreground="#FFCCCCCC"/>
                <Grid ColumnDefinitions="*,Auto">
                    <ComboBox x:Name="BallStyleComboBox" SelectionChanged="BallStyle_Changed"/>
                    <Button Grid.Column="1" Content="Import image…" Margin="8,0,0,0" Click="ImportBallImage_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <Expander Header="Custom panel appearance" Foreground="#FFCCCCCC">
            <Border Background="#22FFFFFF" CornerRadius="8" Padding="10" Margin="0,4,0,0">
                <StackPanel Spacing="8">
                    <CheckBox x:Name="UseCustomAppearanceCheckBox" Content="Enable custom appearance"
                              Checked="UseCustomAppearance_Changed" Unchecked="UseCustomAppearance_Changed"/>
                    <TextBlock Text="Background RGB (0–255)" Foreground="#FFCCCCCC"/>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBox x:Name="BackgroundRedTextBox" Watermark="R" Width="48" TextChanged="AppearanceColor_Changed"/>
                        <TextBox x:Name="BackgroundGreenTextBox" Watermark="G" Width="48" TextChanged="AppearanceColor_Changed"/>
                        <TextBox x:Name="BackgroundBlueTextBox" Watermark="B" Width="48" TextChanged="AppearanceColor_Changed"/>
                        <Button Content="Pick…" Margin="5,0,0,0" Click="PickBackgroundColor_Click"/>
                    </StackPanel>
                    <TextBlock Text="Text RGB (0–255)" Foreground="#FFCCCCCC"/>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBox x:Name="TextRedTextBox" Watermark="R" Width="48" TextChanged="AppearanceColor_Changed"/>
                        <TextBox x:Name="TextGreenTextBox" Watermark="G" Width="48" TextChanged="AppearanceColor_Changed"/>
                        <TextBox x:Name="TextBlueTextBox" Watermark="B" Width="48" TextChanged="AppearanceColor_Changed"/>
                        <Button Content="Pick…" Margin="5,0,0,0" Click="PickTextColor_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="OpacityValueText" Foreground="White"/>
                    <Slider x:Name="BackgroundOpacitySlider" Minimum="0" Maximum="100" ValueChanged="BackgroundOpacity_Changed"/>
                    <TextBlock Text="Panel font" Foreground="#FFCCCCCC"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ComboBox x:Name="PanelFontComboBox" Width="200" SelectionChanged="PanelFont_Changed"/>
                        <Button Content="Reset" Click="ResetAppearance_Click"/>
                    </StackPanel>
                    <Border x:Name="AppearancePreviewBorder" CornerRadius="5" Padding="8">
                        <TextBlock x:Name="AppearancePreviewText" Text="Lychee · Sample text 123"/>
                    </Border>
                </StackPanel>
            </Border>
        </Expander>

        <Border Background="#22FFFFFF" CornerRadius="8" Padding="12">
            <StackPanel Spacing="10">
                <TextBlock Text="Behavior" FontWeight="SemiBold" Foreground="#FFCCCCCC"/>
                <CheckBox x:Name="AlwaysShowCheckBox" Content="Always show panel (pin)"
                          Checked="AlwaysShow_Changed" Unchecked="AlwaysShow_Changed"/>
                <CheckBox x:Name="SnapCheckBox" Content="Snap to nearest screen edge"
                          Checked="Snap_Changed" Unchecked="Snap_Changed"/>
                <CheckBox x:Name="AlertIpCheckBox" Content="Alert when public IP changes"
                          Checked="AlertIp_Changed" Unchecked="AlertIp_Changed"/>
                <CheckBox x:Name="AlertQueryFailCheckBox" Content="Alert on query failure / recovery"
                          Checked="AlertQueryFail_Changed" Unchecked="AlertQueryFail_Changed"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
